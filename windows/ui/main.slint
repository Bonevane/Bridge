// Bridge's windows, in the same Material 3 shapes as the phone app.
// Main window: is my phone reachable, what works right now, what can I do.
// Settings window: the Mac's four tabs. Mirror window: the phone's screen.
import { ScrollView, LineEdit, ListView, TextEdit } from "std-widgets.slint";
import { Theme, Icon, Label, Muted, SectionTitle, Card, PillButton, Toggle, Tile, Divider, Segmented, LinearProgress } from "theme.slint";

export struct Capability {
    name: string,
    detail: string,
    state: int,   // 0 off · 1 limited · 2 working
}

export global AppState {
    in-out property <string> reach-title: "Pair your phone first";
    in-out property <string> reach-detail: "";
    in-out property <int> reach-tint: 0;   // 0 neutral · 1 good · 2 warning · 3 error
    in-out property <bool> busy: false;
    in-out property <bool> searching: false;

    in-out property <bool> paired: false;
    in-out property <bool> linked: false;
    in-out property <bool> phone-tunnel-on: false;
    in-out property <bool> phone-paused: false;
    in-out property <bool> mirroring: false;
    /// The last USB setup stopped short; the hero button runs it again.
    in-out property <bool> usb-retry: false;
    /// The phone is paired in Windows (which breaks the link); the hero button unpairs it.
    in-out property <bool> windows-paired: false;

    in-out property <Capability> screen: { name: "Screen", detail: "", state: 0 };
    in-out property <Capability> notifications: { name: "Notifications", detail: "", state: 0 };
    in-out property <Capability> clipboard: { name: "Clipboard", detail: "", state: 0 };

    // The phone line at the top of the hero: model, battery, network.
    in-out property <string> phone-model: "";
    in-out property <int> phone-battery: -1;   // -1: unknown, hidden
    in-out property <bool> phone-charging: false;
    in-out property <string> phone-network: "";   // "Wi-Fi", "Mobile", "Offline" or ""
    in-out property <string> phone-mode: "";   // "nearby", "anywhere" or ""

    // Now Playing on the phone (hidden when nothing is).
    in-out property <bool> media-visible: false;
    in-out property <string> media-title: "";
    in-out property <string> media-subtitle: "";
    in-out property <image> media-art;
    in-out property <bool> media-has-art: false;
    in-out property <bool> media-playing: false;
    in-out property <float> media-position: 0;   // 0..1
    in-out property <string> media-elapsed: "";
    in-out property <string> media-length: "";
    callback media(string);
    callback seek(float);

    in-out property <bool> show-log: false;
    in-out property <string> log-text: "";
    in-out property <string> version: "";

    callback primary();
    callback refresh();
    callback pause-phone();
    callback toggle-phone-tunnel();
    callback set-up-over-usb();
    callback open-files();
    callback open-settings();
    callback open-log-folder();
    callback quit();
}

export global SettingsState {
    in-out property <bool> launch-at-login;
    in-out property <bool> use-bluetooth;
    in-out property <bool> mirror-notifications;
    in-out property <bool> notifications-anywhere;
    in-out property <bool> sync-clipboard;
    in-out property <bool> background-clipboard;
    in-out property <bool> keep-ready;
    in-out property <int> max-size-index;
    in-out property <int> bitrate-mbps;
    in-out property <bool> turn-screen-off;
    in-out property <bool> mute-phone;
    in-out property <bool> sync-dismiss;

    in-out property <string> ticket-short: "Not paired";
    in-out property <string> pasted: "";
    in-out property <string> pasted-status: "";
    in-out property <string> usb-status: "";
    in-out property <bool> usb-busy: false;

    callback changed();
    callback copy-ticket();
    callback paste-ticket();
    callback apply-pasted();
    callback set-up-over-usb();
    callback unpair();
}

component CapabilityTile inherits Tile {
    in property <Capability> cap;
    title: cap.name;
    subtitle: cap.detail;
    Rectangle {
        width: 10px; height: 10px; border-radius: 5px;
       
        background: cap.state == 2 ? Theme.good : cap.state == 1 ? Theme.warn : Theme.outline;
    }
}

// An icon that names itself on hover (Slint has no tooltips).
component HoverIcon inherits Rectangle {
    in property <image> source;
    in property <color> tint: Theme.on-surface-variant;
    in property <string> hint;
    width: 16px;
    height: 28px;
    Icon { source: root.source; tint: root.tint; width: 15px; height: 15px; y: (parent.height - self.height) / 2; }
    area := TouchArea {}
    if area.has-hover : Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height + 2px;
        width: label.preferred-width + 16px;
        height: 22px;
        border-radius: 6px;
        background: Theme.on-surface;
        label := Text { text: root.hint; color: Theme.background; font-family: Theme.font; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; }
    }
}

// What the phone is playing: the cover, title, artist and app, a seek bar
// you can drag, and previous / play-pause / next.
component NowPlaying inherits Rectangle {
    property <float> dragging: -1;   // 0..1 while the seek bar is held
    border-radius: 16px;
    background: Theme.surface;
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        Rectangle {
            width: 52px; height: 52px;
            border-radius: 10px;
            clip: true;
            background: Theme.surface-highest;
            if AppState.media-has-art : Image { source: AppState.media-art; width: 100%; height: 100%; image-fit: cover; }
            if !AppState.media-has-art : Icon { source: @image-url("icons/music.svg"); width: 24px; height: 24px; x: 14px; y: 14px; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Label { text: AppState.media-title; font-weight: 600; overflow: elide; }
            Muted { text: AppState.media-subtitle; font-size: 12px; wrap: no-wrap; overflow: elide; }
            if AppState.media-length != "" : VerticalLayout {
                spacing: 2px;
                padding-top: 4px;
                Rectangle {
                    height: 12px;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: root.dragging >= 0 ? 6px : 4px;
                        border-radius: self.height / 2;
                        background: Theme.surface-highest;
                        Rectangle {
                            x: 0;
                            width: max(4px, parent.width * (root.dragging >= 0 ? root.dragging : AppState.media-position));
                            height: parent.height;
                            border-radius: parent.border-radius;
                            background: Theme.primary;
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down || (e.kind == PointerEventKind.move && self.pressed)) {
                                root.dragging = clamp(self.mouse-x / self.width, 0, 1);
                            } else if (e.kind == PointerEventKind.up && root.dragging >= 0) {
                                AppState.seek(root.dragging);
                                root.dragging = -1;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    Muted { text: AppState.media-elapsed; font-size: 10px; wrap: no-wrap; horizontal-stretch: 1; }
                    Muted { text: AppState.media-length; font-size: 10px; wrap: no-wrap; }
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 4px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 30px; height: 30px; border-radius: 15px;
                    background: prev.has-hover ? Theme.surface-high : transparent;
                    Icon { source: @image-url("icons/skip-previous.svg"); tint: Theme.on-surface; width: 22px; height: 22px; x: 4px; y: 4px; }
                    prev := TouchArea { clicked => { AppState.media("prev"); } }
                }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 34px; height: 34px; border-radius: 17px;
                    background: play.has-hover ? Theme.on-primary-container : Theme.primary;
                    Icon { source: AppState.media-playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg"); tint: Theme.on-primary; width: 22px; height: 22px; x: 6px; y: 6px; }
                    play := TouchArea { clicked => { AppState.media("toggle"); } }
                }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 30px; height: 30px; border-radius: 15px;
                    background: next.has-hover ? Theme.surface-high : transparent;
                    Icon { source: @image-url("icons/skip-next.svg"); tint: Theme.on-surface; width: 22px; height: 22px; x: 4px; y: 4px; }
                    next := TouchArea { clicked => { AppState.media("next"); } }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Bridge";
    // Resizable: the content follows the window's width and scrolls when
    // the window is shorter than it (a fixed `width` here made the layout
    // stay at 360px in one corner whatever the window did).
    preferred-width: 380px;
    min-width: 300px;
    preferred-height: 780px;
    min-height: 360px;
    background: Theme.background;
    default-font-family: Theme.font;
    icon: @image-url("../assets/icon-256.png");

    property <color> hero-fill: AppState.reach-tint == 1 ? Theme.good-container : AppState.reach-tint == 2 ? Theme.warn-container : AppState.reach-tint == 3 ? Theme.bad-container : Theme.surface-high;
    property <color> hero-accent: AppState.reach-tint == 1 ? Theme.good : AppState.reach-tint == 2 ? Theme.warn : AppState.reach-tint == 3 ? Theme.bad : Theme.primary;

    ScrollView {
        content-width: self.visible-width;
    VerticalLayout {
        padding: 16px;
        spacing: 14px;

        // Top bar: "Bridge" on the left; on the right, while the phone is
        // linked, its name, the mode chosen on it (icon, name on hover), its
        // network and its battery; then refresh.
        // z: drawn above the cards below, so hover labels aren't covered.
        Rectangle {
        z: 1;
        height: 28px;
        HorizontalLayout {
            spacing: 8px;
            Label { text: "Bridge"; font-size: 15px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
            if AppState.phone-battery >= 0 : HorizontalLayout {
                spacing: 8px;
                Muted { text: AppState.phone-model; font-size: 11px; vertical-alignment: center; wrap: no-wrap; horizontal-stretch: 0; }
                if AppState.phone-mode != "" : HoverIcon {
                    source: AppState.phone-mode == "anywhere" ? @image-url("icons/globe.svg") : @image-url("icons/bluetooth.svg");
                    tint: Theme.primary;
                    hint: AppState.phone-mode == "anywhere" ? "Anywhere mode" : "Nearby mode";
                }
                if AppState.phone-network != "" : HoverIcon {
                    source: AppState.phone-network == "Wi-Fi" ? @image-url("icons/wifi.svg") : @image-url("icons/cellular.svg");
                    hint: AppState.phone-network;
                }
                HorizontalLayout {
                    spacing: 2px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            source: AppState.phone-charging ? @image-url("icons/bolt.svg") : @image-url("icons/battery.svg");
                            tint: AppState.phone-charging ? Theme.good : AppState.phone-battery < 20 ? Theme.warn : Theme.on-surface-variant;
                            width: 14px; height: 14px;
                        }
                    }
                    Muted { text: AppState.phone-battery + "%"; font-size: 11px; vertical-alignment: center; wrap: no-wrap;
                        color: AppState.phone-charging ? Theme.good : AppState.phone-battery < 20 ? Theme.warn : Theme.on-surface-variant; }
                }
            }
            Rectangle {
                width: 28px;
                border-radius: 14px;
                background: rf.has-hover ? Theme.surface-high : transparent;
                Icon { source: @image-url("icons/refresh-cw.svg"); width: 18px; height: 18px; x: 5px; y: 5px; }
                rf := TouchArea { clicked => { AppState.refresh(); } }
            }
        }
        }

        // Hero: how the phone is reachable.
        Card {
            hero: true;
            fill: hero-fill;
            VerticalLayout {
                padding: 20px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 10px;
                    Label { text: AppState.reach-title; font-size: 24px; font-weight: 700; color: hero-accent; horizontal-stretch: 1; wrap: word-wrap; }
                    if AppState.busy || (AppState.searching && !AppState.linked && AppState.paired) : Icon {
                        source: @image-url("icons/bluetooth.svg"); tint: hero-accent; width: 22px; height: 22px;
                        opacity: 0.6;
                    }
                }
                Muted { text: AppState.reach-detail; font-size: 12px; color: Theme.on-surface; }
                Rectangle { height: 8px; }
                PillButton {
                    text: AppState.mirroring || AppState.busy ? "Disconnect" : AppState.usb-retry ? "Set up over USB again" : AppState.windows-paired ? "Unpair it in Windows" : AppState.paired ? "Mirror phone" : "Pair from clipboard";
                    kind: "filled";
                    icon: AppState.mirroring || AppState.busy ? @image-url("icons/x.svg") : AppState.usb-retry ? @image-url("icons/usb.svg") : AppState.windows-paired ? @image-url("icons/bluetooth-off.svg") : AppState.paired ? @image-url("icons/screen-share.svg") : @image-url("icons/key-round.svg");
                    clicked => { AppState.primary(); }
                }
            }
        }

        if AppState.media-visible : NowPlaying {}

        // What works right now.
        SectionTitle { text: "Right now"; }
        Card {
            CapabilityTile { icon: @image-url("icons/smartphone.svg"); cap: AppState.screen; }
            Divider {}
            CapabilityTile { icon: @image-url("icons/bell.svg"); cap: AppState.notifications; }
            Divider {}
            CapabilityTile { icon: @image-url("icons/clipboard.svg"); cap: AppState.clipboard; }
        }

        // Actions.
        SectionTitle { text: "Actions"; }
        Card {
            Tile {
                icon: @image-url("icons/pause-circle.svg"); title: "Pause phone for banking"; subtitle: "USB debugging off for 15 minutes";
                clickable: true; enabled: AppState.linked && !AppState.busy;
                clicked => { AppState.pause-phone(); }
                Icon { source: @image-url("icons/chevron-right.svg"); }
            }
            Divider {}
            Tile {
                icon: @image-url("icons/globe.svg");
                title: AppState.phone-tunnel-on ? "Turn phone tunnel off" : "Turn phone tunnel on";
                subtitle: "Switches the phone's internet tunnel over Bluetooth";
                clickable: true; enabled: AppState.linked;
                clicked => { AppState.toggle-phone-tunnel(); }
                Icon { source: @image-url("icons/chevron-right.svg"); }
            }
            Divider {}
            Tile {
                icon: @image-url("icons/folder-open.svg"); title: "Phone files";
                subtitle: "Browse and download; drop files to send them. Works without mirroring.";
                clickable: true; enabled: AppState.paired;
                clicked => { AppState.open-files(); }
                Icon { source: @image-url("icons/chevron-right.svg"); }
            }
            Divider {}
            Tile {
                icon: @image-url("icons/usb.svg"); title: "Set up over USB"; subtitle: "Pair a phone that's plugged in";
                clickable: true; enabled: !AppState.busy && !AppState.mirroring;
                clicked => { AppState.set-up-over-usb(); }
                Icon { source: @image-url("icons/chevron-right.svg"); }
            }
            Divider {}
            Tile {
                icon: @image-url("icons/settings.svg"); title: "Settings"; clickable: true;
                clicked => { AppState.open-settings(); }
                Icon { source: @image-url("icons/chevron-right.svg"); }
            }
            Divider {}
            Tile {
                icon: @image-url("icons/power.svg"); title: "Quit Bridge"; clickable: true;
                clicked => { AppState.quit(); }
            }
        }

        // Activity log, collapsed by default.
        SectionTitle { text: "Log"; }
        Card {
            Tile {
                icon: @image-url("icons/folder.svg"); title: "Activity log"; clickable: true;
                clicked => { AppState.show-log = !AppState.show-log; }
                Icon { source: @image-url("icons/chevron-right.svg"); transform-rotation: AppState.show-log ? 90deg : 0deg; animate transform-rotation { duration: 120ms; } }
            }
            if AppState.show-log : VerticalLayout {
                padding: 12px;
                spacing: 8px;
                // A read-only text box, not Text in a ScrollView: the Text never
                // reported a height, so there was nothing to scroll. This one
                // scrolls on its own, and Ctrl+A / Ctrl+C copy the log.
                TextEdit {
                    height: 220px;
                    text: AppState.log-text;
                    read-only: true;
                    wrap: word-wrap;
                    font-size: 10px;
                }
                PillButton { text: "Open log folder"; icon: @image-url("icons/folder.svg"); clicked => { AppState.open-log-folder(); } }
            }
        }

        Muted { text: "Bridge " + AppState.version + "  ·  made by Bonevane"; horizontal-alignment: center; }
    }
    }
}

component SettingRow inherits Tile {
    in-out property <bool> checked;
    in property <bool> switch-enabled: true;
    callback toggled();
    Toggle { checked <=> root.checked; enabled: switch-enabled; toggled => { root.toggled(); } }
}

component Choice inherits Rectangle {
    in property <[string]> items;
    in-out property <int> current;
    callback changed();
    height: 36px;
    HorizontalLayout {
        spacing: 6px;
        for item[i] in items : Rectangle {
            border-radius: 18px;
            background: i == current ? Theme.primary-container : Theme.surface-highest;
            Text { text: item; color: i == current ? Theme.on-primary-container : Theme.on-surface-variant; font-family: Theme.font; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.current = i; root.changed(); } }
        }
    }
}

export component SettingsWindow inherits Window {
    title: "Bridge settings";
    preferred-width: 480px;
    min-width: 340px;
    preferred-height: 540px;
    min-height: 300px;
    background: Theme.background;
    default-font-family: Theme.font;

    tabs := Segmented { items: ["General", "Phone", "Mirroring", "Pairing"]; x: 16px; y: 16px; width: root.width - 32px; }

    ScrollView {
        x: 0; y: 72px; width: root.width; height: root.height - 72px;
        content-width: self.visible-width;
        VerticalLayout {
            padding: 16px; padding-top: 0;
            spacing: 12px;

            if tabs.current == 0 : VerticalLayout {
                spacing: 12px;
                SectionTitle { text: "Startup"; }
                Card {
                    SettingRow { icon: @image-url("icons/power.svg"); title: "Open Bridge at login"; subtitle: "Bridge lives in the system tray"; checked <=> SettingsState.launch-at-login; toggled => { SettingsState.changed(); } }
                }
                SectionTitle { text: "Short-range link"; }
                Card {
                    SettingRow { icon: @image-url("icons/bluetooth.svg"); title: "Use Bluetooth when the phone is nearby"; subtitle: "Notifications and clipboard for free, no internet needed"; checked <=> SettingsState.use-bluetooth; toggled => { SettingsState.changed(); } }
                }
                SectionTitle { text: "Notifications"; }
                Card {
                    SettingRow { icon: @image-url("icons/bell.svg"); title: "Show the phone's notifications"; subtitle: "Over Bluetooth: free"; checked <=> SettingsState.mirror-notifications; toggled => { SettingsState.changed(); } }
                    Divider {}
                    SettingRow { icon: @image-url("icons/globe.svg"); title: "Also over the internet"; subtitle: "When the phone is out of Bluetooth range. Keeps a tunnel open; costs the phone a little battery and data"; checked <=> SettingsState.notifications-anywhere; switch-enabled: SettingsState.mirror-notifications; toggled => { SettingsState.changed(); } }
                    Divider {}
                    SettingRow { icon: @image-url("icons/check.svg"); title: "Clear on both sides"; subtitle: "Dismissing a notification here clears it on the phone, and clearing it on the phone takes it off this PC"; checked <=> SettingsState.sync-dismiss; switch-enabled: SettingsState.mirror-notifications; toggled => { SettingsState.changed(); } }
                }
                SectionTitle { text: "Clipboard"; }
                Card {
                    SettingRow { icon: @image-url("icons/clipboard.svg"); title: "Sync the clipboard"; subtitle: "Rides the session or Bluetooth: free"; checked <=> SettingsState.sync-clipboard; toggled => { SettingsState.changed(); } }
                    Divider {}
                    SettingRow { icon: @image-url("icons/globe.svg"); title: "Also over the internet"; subtitle: "When the phone is out of Bluetooth range. Keeps the tunnel and the phone's helper running; turns on Keep ready"; checked <=> SettingsState.background-clipboard; switch-enabled: SettingsState.sync-clipboard; toggled => { SettingsState.changed(); } }
                }
            }

            if tabs.current == 1 : VerticalLayout {
                spacing: 12px;
                SectionTitle { text: "Between sessions"; }
                Card {
                    SettingRow {
                        icon: @image-url("icons/smartphone.svg"); title: "Keep the phone ready";
                        subtitle: SettingsState.keep-ready ? "USB debugging stays on, so you can mirror from anywhere, including cellular. Pause it when a banking app complains." : "USB debugging is turned off after each session. The next one needs the phone on Wi-Fi.";
                        checked <=> SettingsState.keep-ready; toggled => { SettingsState.changed(); }
                    }
                }
            }

            if tabs.current == 2 : VerticalLayout {
                spacing: 12px;
                SectionTitle { text: "Video"; }
                Card {
                    VerticalLayout {
                        padding: 16px; spacing: 10px;
                        Label { text: "Resolution"; }
                        Choice { items: ["720", "1024", "1280", "1600", "Full"]; current <=> SettingsState.max-size-index; changed => { SettingsState.changed(); } }
                        Label { text: "Bitrate: " + SettingsState.bitrate-mbps + " Mbps"; }
                        Choice { items: ["1", "2", "4", "8", "12", "16"]; current: SettingsState.bitrate-mbps == 1 ? 0 : SettingsState.bitrate-mbps == 2 ? 1 : SettingsState.bitrate-mbps == 4 ? 2 : SettingsState.bitrate-mbps == 8 ? 3 : SettingsState.bitrate-mbps == 12 ? 4 : 5;
                            changed => { SettingsState.bitrate-mbps = self.current == 0 ? 1 : self.current == 1 ? 2 : self.current == 2 ? 4 : self.current == 3 ? 8 : self.current == 4 ? 12 : 16; SettingsState.changed(); } }
                        Muted { text: "Bridge lowers the bitrate by itself when the connection can't keep up, and raises it again when it can."; }
                    }
                }
                SectionTitle { text: "While mirroring"; }
                Card {
                    SettingRow { icon: @image-url("icons/monitor.svg"); title: "Turn the phone's screen off"; checked <=> SettingsState.turn-screen-off; toggled => { SettingsState.changed(); } }
                    Divider {}
                    SettingRow { icon: @image-url("icons/volume-off.svg"); title: "Mute the phone"; subtitle: "Audio plays here only"; checked <=> SettingsState.mute-phone; toggled => { SettingsState.changed(); } }
                }
            }

            if tabs.current == 3 : VerticalLayout {
                spacing: 12px;
                SectionTitle { text: "This phone"; }
                Card {
                    Tile { icon: @image-url("icons/key-round.svg"); title: "Ticket"; subtitle: SettingsState.ticket-short;
                        PillButton { text: "Copy"; height: 34px; clicked => { SettingsState.copy-ticket(); } }
                    }
                    Divider {}
                    Tile { icon: @image-url("icons/usb.svg"); title: "Set up over USB"; subtitle: SettingsState.usb-status == "" ? "Plug the phone in with USB debugging on, then click" : SettingsState.usb-status;
                        PillButton { text: SettingsState.usb-busy ? "Working…" : "Set up"; kind: "filled"; height: 34px; enabled: !SettingsState.usb-busy; clicked => { SettingsState.set-up-over-usb(); } }
                    }
                }
                Muted { text: "Treat the ticket like a password: anyone who has it and the pairing secret can reach the phone."; horizontal-alignment: center; }
                SectionTitle { text: "Pair without a cable"; }
                Card {
                    VerticalLayout {
                        padding: 16px; spacing: 10px;
                        LineEdit { placeholder-text: "endpoint… <secret>"; text <=> SettingsState.pasted; font-size: 12px; }
                        HorizontalLayout {
                            spacing: 8px;
                            PillButton { text: "Paste"; clicked => { SettingsState.paste-ticket(); } }
                            PillButton { text: "Pair"; kind: "filled"; enabled: SettingsState.pasted != ""; clicked => { SettingsState.apply-pasted(); } }
                        }
                        if SettingsState.pasted-status != "" : Muted { text: SettingsState.pasted-status; }
                        Muted { text: "On the phone, tap Copy under Ticket and get it to this PC privately (a message to yourself, a note). Never post the ticket anywhere: it's a key, not an address."; }
                    }
                }
                PillButton { text: "Unpair"; kind: "outlined"; icon: @image-url("icons/x.svg"); clicked => { SettingsState.unpair(); } }
            }
        }
    }
}

// The phone's screen. Fills the window, keeps its aspect; every pointer and
// key event goes to the phone as a scrcpy control message (see scrcpy.rs).
export component MirrorWindow inherits Window {
    in-out property <string> phone-name: "Phone";
    title: root.phone-name + " (Bridge)";
    background: black;
    in-out property <image> frame;
    in-out property <length> video-width: 1080px;
    in-out property <length> video-height: 2400px;
    preferred-height: 820px;
    preferred-width: 820px * video-width / video-height;

    callback pointer(int, int, int, int);
    callback scroll(int, int, float, float);
    callback key(string, int, bool);

    // A file being sent or fetched: shown as a bar over the bottom of the picture.
    in-out property <bool> transfer-visible: false;
    in-out property <string> transfer-text: "";
    in-out property <float> transfer-progress: 0;

    property <float> scale: min(root.width / root.video-width, root.height / root.video-height);
    property <length> shown-w: root.video-width * scale;
    property <length> shown-h: root.video-height * scale;
    property <length> off-x: (root.width - shown-w) / 2;
    property <length> off-y: (root.height - shown-h) / 2;
    pure function px(x: length) -> int { return (x - off-x) / scale / 1px; }
    pure function py(y: length) -> int { return (y - off-y) / scale / 1px; }

    Image {
        source: root.frame;
        image-fit: contain;
        width: 100%;
        height: 100%;
        image-rendering: smooth;
    }

    focus := FocusScope {
        key-pressed(event) => {
            root.key(event.text, (event.modifiers.control ? 1 : 0) + (event.modifiers.shift ? 2 : 0) + (event.modifiers.alt ? 4 : 0), true);
            accept
        }
        key-released(event) => {
            root.key(event.text, (event.modifiers.control ? 1 : 0) + (event.modifiers.shift ? 2 : 0) + (event.modifiers.alt ? 4 : 0), false);
            accept
        }
        TouchArea {
            mouse-cursor: default;
            pointer-event(e) => {
                focus.focus();
                if (e.kind == PointerEventKind.down) {
                    root.pointer(px(self.mouse-x), py(self.mouse-y), 0, e.button == PointerEventButton.right ? 1 : 0);
                } else if (e.kind == PointerEventKind.up) {
                    root.pointer(px(self.mouse-x), py(self.mouse-y), 1, e.button == PointerEventButton.right ? 1 : 0);
                } else if (e.kind == PointerEventKind.move) {
                    root.pointer(px(self.mouse-x), py(self.mouse-y), self.pressed ? 2 : 3, 0);
                }
            }
            scroll-event(e) => {
                root.scroll(px(self.mouse-x), py(self.mouse-y), e.delta-x / 1px, e.delta-y / 1px);
                accept
            }
        }
    }

    if root.transfer-visible : Rectangle {
        x: 12px;
        y: root.height - self.height - 12px;
        width: root.width - 24px;
        height: 54px;
        border-radius: 16px;
        background: #000000cc;
        VerticalLayout {
            padding: 12px;
            spacing: 6px;
            Text { text: root.transfer-text; color: white; font-size: 12px; overflow: elide; }
            LinearProgress { value: root.transfer-progress; }
        }
    }
}

export struct FileEntry {
    name: string,
    detail: string,
    is-dir: bool,
}

// The phone's shared storage (what its Files app shows). Click a folder to
// open it, a file to download it into this PC's Downloads folder. Files
// dropped on this window go to the phone's Download folder.
export component FilesWindow inherits Window {
    title: "Phone files";
    preferred-width: 520px;
    min-width: 340px;
    preferred-height: 620px;
    min-height: 320px;
    background: Theme.background;
    default-font-family: Theme.font;
    icon: @image-url("../assets/icon-256.png");

    in-out property <string> path: "";
    in-out property <bool> at-top: true;
    in-out property <[FileEntry]> entries: [];
    in-out property <string> status: "";
    in-out property <bool> loading: false;
    /// Transfer progress, 0 to 1; below 0 hides the bar.
    in-out property <float> progress: -1;

    callback open(int);
    callback up();
    callback refresh();
    callback open-downloads();

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 8px;
            PillButton { text: "Up"; icon: @image-url("icons/arrow-up.svg"); enabled: !root.at-top && !root.loading; clicked => { root.up(); } }
            Label { text: root.path; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; color: Theme.on-surface-variant; }
            PillButton { text: "Refresh"; icon: @image-url("icons/refresh-cw.svg"); enabled: !root.loading; clicked => { root.refresh(); } }
        }

        Card {
            vertical-stretch: 1;
            ListView {
                for e[i] in root.entries : Tile {
                    icon: e.is-dir ? @image-url("icons/folder.svg") : @image-url("icons/file.svg");
                    title: e.name;
                    subtitle: e.detail;
                    clickable: true;
                    enabled: !root.loading;
                    clicked => { root.open(i); }
                    if !e.is-dir : Icon { source: @image-url("icons/download.svg"); }
                    if e.is-dir : Icon { source: @image-url("icons/chevron-right.svg"); }
                }
            }
        }

        if root.progress >= 0 : LinearProgress { value: root.progress; }
        HorizontalLayout {
            spacing: 8px;
            Muted { text: root.status; vertical-alignment: center; horizontal-stretch: 1; }
            PillButton { text: "Open Downloads"; kind: "outlined"; icon: @image-url("icons/folder.svg"); clicked => { root.open-downloads(); } }
        }
    }
}
